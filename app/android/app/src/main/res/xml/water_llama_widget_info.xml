<?xml version="1.0" encoding="utf-8"?>
<!-- 喝水养成桌面小组件元信息
     唯一固定样式（对标竞品「柠檬喝水」）：布局固定不可编辑，
     默认占 4×2 格；resizeMode 不含 horizontal|vertical → 用户无法
     拉伸改形，样式在所有厂商桌面（OriginOS/EMUI/MHCI 等）完全一致。
     updatePeriodMillis 为系统兜底轮询；数据实时性由 Dart 侧推送保证 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="190dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/water_llama_widget"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
