<?xml version="1.0" encoding="utf-8"?>
<!-- 连续徽章：白色圆 + 浅描边（对标 App 预览卡徽章）。
     2dp 描边：launcher 压缩渲染 + 截图压缩下 1.5dp 浅灰描边
     抗锯齿断裂呈"缺口"，加深加粗保证整圈可见 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFF" />
    <stroke android:width="2dp" android:color="#D9D9E1" />
</shape>
