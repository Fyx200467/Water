<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件布局：对标 App 内「小组件」设置页预览卡（中尺寸）
     左上目标容量+百分比 / 右侧角色插画 / 左下连续徽章圆 / 右列饮料格
     主题色背景通过 widget_bg_img 的 setColorFilter 动态染色 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- 背景层：白色圆角块，代码可染成用户选择的主题色 -->
    <ImageView
        android:id="@id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- 达标礼炮彩带层（provider 按当日是否达标决定显隐）：插在背景之上、
         角色/内容层之下 → 彩带贴在卡面上但不遮挡数字与饮品格；ImageView
         无点击监听，触摸事件继续下传，不拦截饮品格点按 -->
    <ImageView
        android:id="@id/widget_confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- 角色定位层：羊驼居中于第一格 → 中心 = 第一格中点。要中心落
         在卡宽 34%（3 列窄卡上远离右侧饮品列），第一格须占 68%
         （权重 0.53/0.25）；此前 80/20 中心在 40%，窄卡上右缘几乎
         贴到饮品文字。声明在内容层之前 = 羊驼沉底（z 序），与
         文字/徽章重叠时不穿帮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:clipChildren="false">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.53"
            android:clipChildren="false">

            <ImageView
                android:id="@id/widget_character"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_alpaca"
                android:contentDescription="@null" />

            <!-- 液体动画层：launcher 进程内自动轮播波浪相位图（App 不在
                 前台也持续动画）；必须 VISIBLE 装载，隐藏由 provider
                 每次重绘显式接管 -->
            <ViewFlipper
                android:id="@id/widget_character_flipper"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:autoStart="true"
                android:flipInterval="100"
                android:visibility="invisible">

                <ImageView
                    android:id="@id/widget_char_f0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f9"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f12"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f13"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f14"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/widget_char_f15"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </ViewFlipper>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.25" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:clipChildren="false">

        <!-- 左列：目标（上）+ 徽章（下）。RelativeLayout 固定锚点：
             徽章永远钉在列底（小尺寸下不会像线性堆叠那样被推出底边裁切） -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- 总量数字+单位：provider 用 Canvas 直接绘成位图塞进固定
                 dp 的 ImageView。vivo launcher 对 RemoteViews TextView
                 的文本量测有自身缓存缺陷（宽文本尾部被裁/异常换行，
                 布局侧多次修复均无效），位图路径完全不经过文本量测 -->
            <ImageView
                android:id="@id/widget_goal_img"
                android:layout_width="56dp"
                android:layout_height="24dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_marginTop="2dp"
                android:scaleType="fitStart"
                android:contentDescription="@null" />

            <TextView
                android:id="@id/widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/widget_goal_img"
                android:layout_alignParentStart="true"
                android:textSize="12sp"
                android:textColor="@color/widget_text_gray"
                android:text="0%" />

            <!-- 徽章：常态显示天数；当日达标后 widget_badge_flipper 接管，
                 ✓ 与天数每 2s 轮播（与 App 首页左上角按钮同款交互） -->
            <FrameLayout
                android:id="@id/widget_streak_badge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginBottom="14dp">

                <!-- match_parent 跟随外框：外框尺寸由 provider 按档位改设
                     （30/34dp），固定 32dp 会在紧凑档被外框裁掉 1dp 一圈，
                     浅色描边看起来像"缺了一块" -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_badge_bg"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@id/widget_streak"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_dark"
                    android:text="0" />

                <!-- 必须 VISIBLE 装载：vivo launcher 对初始 INVISIBLE 的
                     ViewFlipper 不做子视图管理（✓ 与数字层叠、autoStart 不
                     轮播）。provider 每次重绘都显式设 VISIBLE/GONE，此处
                     不存在初始歧义；羊驼 flipper 同模式正常轮播 -->
                <ViewFlipper
                    android:id="@id/widget_badge_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoStart="true"
                    android:flipInterval="2000">

                    <TextView
                        android:id="@id/widget_streak_check"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="✓" />

                    <TextView
                        android:id="@id/widget_streak_num"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="0" />
                </ViewFlipper>
            </FrameLayout>
        </RelativeLayout>

        <!-- 羊驼已移入整卡 35% 定位层（widget_bg_img 之后的 overlay），
             内容层不再需要中列占位：左列吃掉全部弹性空间，饮品格靠右 -->

        <!-- 右列：饮料格竖排 -->
        <LinearLayout
            android:id="@id/widget_drinks"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <!-- 三行各占列高 1/3（weight=1）：5×9 等高密度网格下整卡被
                 压矮时行高随卡片连续收缩，内容靠行内 gravity 垂直居中，
                 不再被固定行高挤出底边。行间视觉留白来自 provider 把
                 按钮高度压到行高 −8dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@id/widget_d1_ml"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="250ml" />

                    <TextView
                        android:id="@id/widget_d1_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_gray"
                        android:text="" />
                </LinearLayout>

                <FrameLayout
                    android:id="@id/widget_d1_btn"
                    android:layout_width="62dp"
                android:layout_height="44dp">

                    <!-- 底色独立成 ImageView：RemoteViews 才能按彩色饮料按钮开关染色 -->
                    <ImageView
                        android:id="@id/widget_d1_tile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_tile_bg"
                        android:contentDescription="@null" />

                    <!-- + 在按钮内部、图标左侧（视觉引导「点按即添加」） -->
                    <TextView
                        android:id="@id/widget_d1_plus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="+" />

                    <ImageView
                        android:id="@id/widget_d1_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@id/widget_d2_ml"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="" />

                    <TextView
                        android:id="@id/widget_d2_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_gray"
                        android:text="" />
                </LinearLayout>

                <FrameLayout
                    android:id="@id/widget_d2_btn"
                    android:layout_width="62dp"
                android:layout_height="44dp">

                    <ImageView
                        android:id="@id/widget_d2_tile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_tile_bg"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@id/widget_d2_plus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="+" />

                    <ImageView
                        android:id="@id/widget_d2_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@id/widget_d3_ml"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="" />

                    <TextView
                        android:id="@id/widget_d3_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_gray"
                        android:text="" />
                </LinearLayout>

                <FrameLayout
                    android:id="@id/widget_d3_btn"
                    android:layout_width="62dp"
                android:layout_height="44dp">

                    <ImageView
                        android:id="@id/widget_d3_tile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_tile_bg"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@id/widget_d3_plus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_dark"
                        android:text="+" />

                    <ImageView
                        android:id="@id/widget_d3_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
