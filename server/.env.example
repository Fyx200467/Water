# 复制为 .env 后填写真实值

# Web 服务
PORT=3000
CORS_ORIGINS=*

# 数据库
DATABASE_URL=postgresql://waterllama:waterllama@localhost:5432/waterllama?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-32-char-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 推送（M4 接入）
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.waterllama.waterLlama
FCM_SERVER_KEY=

# AI 厂商（V2.0 用）
AI_PROVIDER=doubao
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
